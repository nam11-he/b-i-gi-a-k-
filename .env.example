# Copy to .env before running `docker compose up` (cp .env.example .env)

# PostgreSQL: one server, one database per service (auth_db, learning_db)
POSTGRES_USER=nambede
POSTGRES_PASSWORD=nambede
POSTGRES_PORT=5432

# JWT: auth-service signs with RS256. Its key pair is made on the first start and kept in auth_db (signing_keys);
# the other services verify with the public keys at http://localhost:8081/.well-known/jwks.json. Nothing to set.
JWT_EXPIRATION_MINUTES=1440

# Admin account created by auth-service on first start
ADMIN_EMAIL=admin@nambede.local
ADMIN_PASSWORD=Admin@123

# Web app: http://nambede.dev.localhost (if port 80 is taken, change WEB_PORT and add :<port> to the URL)
WEB_PORT=80

# Origins allowed to call the gateway from a browser (comma-separated)
CORS_ORIGINS=http://nambede.dev.localhost,http://localhost:5173

# true = skip Maven tests during `docker compose build` (faster rebuilds)
SKIP_TESTS=false
